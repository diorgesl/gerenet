GERENET_DATABASE_URL=postgresql+psycopg://gerenet:gerenet@localhost:5432/gerenet
GERENET_REDIS_URL=redis://localhost:6379/0
GERENET_VAULT_URL=http://localhost:8200
GERENET_VAULT_TOKEN=gerenet-dev-root
GERENET_API_KEY=trocar-em-producao

# Conta de automação usada na coleta (grupo `automacao`, caminho
# gerenet/credential-groups/automacao). O vault do compose é 'dev' e in-memory:
# a cada restart ele re-grava este segredo a partir do `.env`. Sem password aqui,
# a coleta falha com "Falha ao ler o segredo" — deixe em branco só se for trocar
# a credencial manualmente via `gerenet vault seed`.
GERENET_VAULT_USERNAME=gerenet-auto
# GERENET_VAULT_PASSWORD=senha-real-da-conta-de-automacao

# Coleta periódica (worker): minutos entre varreduras; 0 desliga. O worker arma
# na subida, então mudar o valor pede restart dele.
# GERENET_COLLECT_INTERVAL_MINUTES=60

# Token do /metrics (rede de gerência). Ausente, o endpoint fica aberto a quem
# alcança a rede; string vazia derruba a API de propósito (o Settings recusa
# token vazio — é o que impede "token vazio = endpoint aberto").
# GERENET_METRICS_TOKEN=trocar-em-producao
