# Ambiente da produção: copie para `.env`, no mesmo diretório do compose, e
# preencha. Fica fora do git — o `.gitignore` cobre `.env` e `.env.prod`.
#
#   cp .env.prod.example /opt/gerenet/.env && chmod 600 /opt/gerenet/.env
#
# As variáveis marcadas com `?` no compose.prod.example.yaml são obrigatórias:
# faltando qualquer uma, o `docker compose` recusa subir em vez de usar um
# valor fraco em silêncio.

# Nome da stack: entra nos nomes de routers e serviços do Traefik
# (ex.: gerenet-api-https), então precisa ser único no host.
STACK_NAME=gerenet

# Host servido pelo Traefik. O DNS precisa apontar para este servidor e o
# certificado é emitido pelo certresolver `le` (Let's Encrypt), o que exige a
# porta 80 alcançável da internet para o desafio.
GERENET_DOMAIN=gerenet.exemplo.com.br

# Imagem construída no próprio host (`docker compose up -d --build`). Se você
# publicar a imagem num registry, troque por ela e remova o `build:` dos
# serviços no compose.
DOCKER_IMAGE_GERENET=gerenet
TAG=latest

# Senha do Postgres. Gere uma: `openssl rand -base64 32`.
# Vale para o container E para a URL que a api usa (o compose monta a
# GERENET_DATABASE_URL a partir dela).
POSTGRES_PASSWORD=

# Token do Vault usado pela api e pelo worker. É criado no runbook, depois do
# init/unseal, com uma policy restrita ao caminho gerenet/*.
GERENET_VAULT_TOKEN=

# Chave da API para CLI e automações (header X-Api-Key). O login web usa
# usuário e senha, não esta chave.
GERENET_API_KEY=

# Token do /metrics (header Bearer). Sem ele o endpoint responde a quem
# alcança a rede interna; string vazia derruba a api de propósito.
GERENET_METRICS_TOKEN=

# Coleta periódica do worker, em minutos. 0 desliga.
GERENET_COLLECT_INTERVAL_MINUTES=60
