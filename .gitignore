# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# estado local de sessão (j-space, testes) — não é do projeto
.jspace/

# logs e bancos locais
logs/
*.log
*.db
*.sqlite3
processed_serials.json

# segredos e config local (tokens do portal/telegram + credenciais sftp
# embutidas nas URLs de firmware — o config real fica fora do projeto)
config.yaml
deploy/docker/.env

graphify-out

# app gerenet
data/
.claude/settings.local.json
.docker/
*.env

# produção: o `.env` do servidor é cópia do .env.prod.example
.env.prod

# compose de cada máquina fica fora do git; os dois exemplos é que sobem
/compose*.yaml
!/compose.example.yaml
!/compose.prod.example.yaml

# worktrees do harness: são cópias de trabalho, não conteúdo do repo (sem esta
# linha um `git add .` as commita como gitlink e elas viram submódulo fantasma)
.claude/worktrees/

# web (frontend)
# sem a barra final: com ela, o padrão casa só diretório e o symlink para o
# install de outro checkout (a worktree aponta para o node_modules da irmã)
# aparece como não rastreado — e um `git add .` o commitaria.
web/node_modules
web/dist/
web/playwright-report/
web/test-results/
