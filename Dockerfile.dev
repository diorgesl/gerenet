# Imagem de desenvolvimento (compose): projeto editável + grupo dev (pytest/ruff).
# O compose usa bind mounts de src/alembic para hot reload; releitura de
# dependências exige rebuild (`docker compose build`).
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /srv/app

# Scripts do venv disponíveis para qualquer exec (inclusive `docker compose exec`)
ENV PATH="/srv/app/.venv/bin:$PATH"

# O cliente `whois` é chamado por subprocess em `automation/irr.py`
# (`identificar_asn` e `consultar`); a imagem slim não o traz. Sem ele a
# consulta ao registro falha com FileNotFoundError e a api responde 503.
RUN apt-get update && \
    apt-get install -y --no-install-recommends whois && \
    rm -rf /var/lib/apt/lists/*

# Manifestos primeiro (cache de camada)
COPY pyproject.toml uv.lock ./
COPY alembic.ini ./
COPY alembic ./alembic
COPY src ./src

RUN uv sync --frozen

COPY docker/entrypoint.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint

# O entrypoint aplica as migrações quando RUN_MIGRATIONS=true (só a api do
# compose liga; o worker roda com "false" para não correr com ela).
ENTRYPOINT ["/usr/local/bin/entrypoint"]

# Default: API com hot reload (compose/worker podem sobrescrever via command)
CMD ["uv", "run", "uvicorn", "gerenet.api.main:create_app", "--factory", "--reload", "--host", "0.0.0.0", "--port", "8000"]
